{
  "lexicon": 1,
  "id": "com.woomarks.annotation.defs",
  "description": "W3C Web Annotation selector and state definitions",
  "defs": {
    "textQuoteSelector": {
      "type": "object",
      "description": "W3C TextQuoteSelector: identifies text by quoting it with optional context",
      "required": ["type", "exact"],
      "properties": {
        "type": {
          "type": "string",
          "const": "TextQuoteSelector"
        },
        "exact": {
          "type": "string",
          "maxLength": 5000,
          "description": "The exact text being selected"
        },
        "prefix": {
          "type": "string",
          "maxLength": 500,
          "description": "Text immediately before the selection for disambiguation"
        },
        "suffix": {
          "type": "string",
          "maxLength": 500,
          "description": "Text immediately after the selection for disambiguation"
        },
        "refinedBy": {
          "type": "union",
          "refs": ["#textQuoteSelector", "#textPositionSelector"],
          "description": "Refine this selector with another selector"
        }
      }
    },
    "textPositionSelector": {
      "type": "object",
      "description": "W3C TextPositionSelector: identifies text by character position offsets",
      "required": ["type", "start", "end"],
      "properties": {
        "type": {
          "type": "string",
          "const": "TextPositionSelector"
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "description": "Starting character position (inclusive)"
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "description": "Ending character position (exclusive)"
        },
        "refinedBy": {
          "type": "union",
          "refs": ["#textQuoteSelector"],
          "description": "Refine this selector with another selector"
        }
      }
    },
    "rangeSelector": {
      "type": "object",
      "description": "W3C RangeSelector: defines a range using start and end selectors",
      "required": ["type", "startSelector", "endSelector"],
      "properties": {
        "type": {
          "type": "string",
          "const": "RangeSelector"
        },
        "startSelector": {
          "type": "union",
          "refs": ["#xpathSelector", "#cssSelector", "#textPositionSelector"],
          "description": "Selector for the start of the range"
        },
        "endSelector": {
          "type": "union",
          "refs": ["#xpathSelector", "#cssSelector", "#textPositionSelector"],
          "description": "Selector for the end of the range"
        },
        "refinedBy": {
          "type": "union",
          "refs": ["#textQuoteSelector"],
          "description": "Refine this selector"
        }
      }
    },
    "fragmentSelector": {
      "type": "object",
      "description": "W3C FragmentSelector: uses URI fragment identifiers",
      "required": ["type", "value"],
      "properties": {
        "type": {
          "type": "string",
          "const": "FragmentSelector"
        },
        "value": {
          "type": "string",
          "maxLength": 2000,
          "description": "The fragment identifier (e.g., 't=30,60' for media)"
        },
        "conformsTo": {
          "type": "string",
          "format": "uri",
          "description": "IRI of the fragment syntax specification"
        },
        "refinedBy": {
          "type": "union",
          "refs": ["#textQuoteSelector"],
          "description": "Refine this selector"
        }
      }
    },
    "cssSelector": {
      "type": "object",
      "description": "W3C CssSelector: uses CSS selectors to identify DOM elements",
      "required": ["type", "value"],
      "properties": {
        "type": {
          "type": "string",
          "const": "CssSelector"
        },
        "value": {
          "type": "string",
          "maxLength": 2000,
          "description": "CSS selector string (e.g., '#id > .class + p')"
        },
        "refinedBy": {
          "type": "union",
          "refs": ["#textQuoteSelector", "#textPositionSelector"],
          "description": "Refine this selector"
        }
      }
    },
    "xpathSelector": {
      "type": "object",
      "description": "W3C XPathSelector: uses XPath to identify elements in XML/HTML",
      "required": ["type", "value"],
      "properties": {
        "type": {
          "type": "string",
          "const": "XPathSelector"
        },
        "value": {
          "type": "string",
          "maxLength": 2000,
          "description": "XPath expression"
        },
        "refinedBy": {
          "type": "union",
          "refs": ["#textQuoteSelector", "#textPositionSelector"],
          "description": "Refine this selector"
        }
      }
    },
    "dataPositionSelector": {
      "type": "object",
      "description": "W3C DataPositionSelector: identifies byte range in binary data",
      "required": ["type", "start", "end"],
      "properties": {
        "type": {
          "type": "string",
          "const": "DataPositionSelector"
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "description": "Starting byte position (inclusive)"
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "description": "Ending byte position (exclusive)"
        }
      }
    },
    "svgSelector": {
      "type": "object",
      "description": "W3C SvgSelector: defines a shape using SVG",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "const": "SvgSelector"
        },
        "value": {
          "type": "string",
          "maxLength": 10000,
          "description": "SVG content (if embedded)"
        },
        "id": {
          "type": "string",
          "format": "uri",
          "description": "IRI of external SVG resource"
        }
      }
    },
    "pageSelector": {
      "type": "object",
      "description": "PDF page selector (Hypothesis extension, compatible with W3C model)",
      "required": ["type", "index"],
      "properties": {
        "type": {
          "type": "string",
          "const": "PageSelector"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "description": "0-based page index"
        },
        "label": {
          "type": "string",
          "maxLength": 50,
          "description": "Human-readable page number (e.g., 'vi', '6')"
        }
      }
    },
    "mediaTimeSelector": {
      "type": "object",
      "description": "Media time selector for video/audio (Hypothesis extension, W3C uses FragmentSelector)",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "const": "MediaTimeSelector"
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "description": "Start time in seconds"
        },
        "end": {
          "type": "number",
          "minimum": 0,
          "description": "End time in seconds"
        }
      }
    },
    "epubContentSelector": {
      "type": "object",
      "description": "EPUB chapter/section selector (Hypothesis extension for EPUBs)",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "const": "EPUBContentSelector"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "EPUB content document URL"
        },
        "cfi": {
          "type": "string",
          "maxLength": 500,
          "description": "EPUB Canonical Fragment Identifier"
        },
        "title": {
          "type": "string",
          "maxLength": 500,
          "description": "Chapter/section title"
        }
      }
    },
    "shapeSelector": {
      "type": "object",
      "description": "Shape selector for image/PDF regions (Hypothesis extension, can be mapped to SvgSelector)",
      "required": ["type", "shape"],
      "properties": {
        "type": {
          "type": "string",
          "const": "ShapeSelector"
        },
        "shape": {
          "type": "ref",
          "ref": "#shape"
        },
        "anchor": {
          "type": "string",
          "knownValues": ["page", "canvas"],
          "description": "What the coordinates are relative to"
        },
        "view": {
          "type": "ref",
          "ref": "#rectangle",
          "description": "The viewport dimensions at time of annotation"
        }
      }
    },
    "shape": {
      "type": "object",
      "description": "Geometric shape definition",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "knownValues": ["rect", "polygon", "circle"],
          "description": "Shape type"
        },
        "left": {
          "type": "number",
          "description": "For rect: left coordinate"
        },
        "top": {
          "type": "number",
          "description": "For rect: top coordinate"
        },
        "right": {
          "type": "number",
          "description": "For rect: right coordinate"
        },
        "bottom": {
          "type": "number",
          "description": "For rect: bottom coordinate"
        },
        "cx": {
          "type": "number",
          "description": "For circle: center x"
        },
        "cy": {
          "type": "number",
          "description": "For circle: center y"
        },
        "r": {
          "type": "number",
          "description": "For circle: radius"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "#point"
          },
          "description": "For polygon: array of points"
        }
      }
    },
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "rectangle": {
      "type": "object",
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "left": {
          "type": "number"
        },
        "top": {
          "type": "number"
        },
        "right": {
          "type": "number"
        },
        "bottom": {
          "type": "number"
        }
      }
    },
    "timeState": {
      "type": "object",
      "description": "W3C TimeState: describes temporal state of resource",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "const": "TimeState"
        },
        "sourceDate": {
          "type": "string",
          "format": "datetime",
          "description": "Specific timestamp of the resource state"
        },
        "sourceDateStart": {
          "type": "string",
          "format": "datetime",
          "description": "Start of time interval"
        },
        "sourceDateEnd": {
          "type": "string",
          "format": "datetime",
          "description": "End of time interval"
        },
        "cached": {
          "type": "string",
          "format": "uri",
          "description": "IRI of cached copy"
        },
        "refinedBy": {
          "type": "union",
          "refs": ["#httpRequestState"],
          "description": "Refine with additional state"
        }
      }
    },
    "httpRequestState": {
      "type": "object",
      "description": "W3C HttpRequestState: HTTP headers needed to retrieve resource state",
      "required": ["type", "value"],
      "properties": {
        "type": {
          "type": "string",
          "const": "HttpRequestState"
        },
        "value": {
          "type": "string",
          "maxLength": 2000,
          "description": "HTTP request headers as string (e.g., 'Accept: application/pdf')"
        }
      }
    }
  }
}
