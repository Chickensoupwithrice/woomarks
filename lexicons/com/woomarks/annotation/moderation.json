{
  "lexicon": 1,
  "id": "com.woomarks.annotation.moderation",
  "defs": {
    "main": {
      "type": "record",
      "description": "Moderation action taken on an annotation",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["subject", "action", "createdAt"],
        "properties": {
          "subject": {
            "type": "string",
            "format": "at-uri",
            "description": "The annotation being moderated"
          },
          "action": {
            "type": "string",
            "knownValues": ["approve", "hide", "delete", "mark-spam"],
            "description": "Moderation action taken"
          },
          "reason": {
            "type": "string",
            "maxLength": 2000,
            "maxGraphemes": 1000,
            "description": "Reason for the moderation action"
          },
          "moderator": {
            "type": "string",
            "format": "did",
            "description": "DID of the moderator (if not the record creator)"
          },
          "expiresAt": {
            "type": "string",
            "format": "datetime",
            "description": "When this moderation action expires (for temporary actions)"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "knownValues": ["approved", "pending", "hidden", "spam"],
      "description": "Moderation status of an annotation"
    }
  }
}
